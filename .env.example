# Servidor e Banco
PORT=3000
DATABASE_PATH=/app/data/bot.sqlite
ADMIN_USER=admin
ADMIN_PASSWORD=admin
WEBHOOK_SECRET=change-me-too
WORKER_POLL_MS=1000

# WhatsApp / Evolution API
EVOLUTION_URL=https://api.seuevolution.com
EVOLUTION_INSTANCE=nome_da_instancia
EVOLUTION_KEY=sua_global_api_key

# Shopee Affiliate API
SHOPEE_APP_ID=seu_app_id
SHOPEE_SECRET=sua_chave_secreta
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
AFFILIATE_ID=seu_subid_opcional

# Configurações do Bot
BOT_ACTIVE=1
SEND_MODE=preview
SEND_WITHOUT_LINK=0
REQUEST_TIMEOUT=15000
MAX_ATTEMPTS=3
